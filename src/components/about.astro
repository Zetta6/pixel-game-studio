---
import { Image } from "astro:assets";
import estudio from "../assets/studio.jpg";

const { mostrarBoton = true } = Astro.props;
---

<section class="nosotros">

    <div class="imagen">
        <Image
            src={estudio}
            alt="Estudio de desarrollo"
            widths={[480, 768, 1200]}
            sizes="(max-width: 768px) 100vw, 45vw"
            format="webp"
            loading="lazy"
        />
    </div>

    <div class="informacion">

        <span>CONOCE NUESTRO ESTUDIO</span>

        <h2>Quiénes somos</h2>

        <p>
            Pixel Games Studio es un estudio independiente
            de desarrollo de videojuegos que nace de la
            pasión por el arte, la tecnología y el
            entretenimiento digital.
        </p>

        <p>
            Nuestro objetivo es crear mundos únicos,
            historias memorables y experiencias que
            conecten con los jugadores.
            Creemos que los videojuegos son una forma
            de expresión artística.
        </p>

        {mostrarBoton && (
            <a href="/quienes-somos" class="boton">
                Conoce nuestro equipo
            </a>
        )}

    </div>

</section>

<style>

    .nosotros {
        padding: 80px 8%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 50px;
    }

    .imagen img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        border-radius: 15px;
    }

    span {
        color: #a78bfa;
        font-size: 14px;
        letter-spacing: 2px;
    }

    h2 {
        font-size: 36px;
        margin: 15px 0;
    }

    p {
        color: #b8b8c4;
        font-size: 17px;
        line-height: 1.7;
    }

    .boton {
        display: inline-block;
        background-color: #7c3aed;
        padding: 15px 25px;
        border-radius: 8px;
        margin-top: 15px;
    }

    .boton:hover {
        background-color: #6d28d9;
    }

    @media (max-width: 768px) {

        .nosotros {
            grid-template-columns: 1fr;
            text-align: center;
        }

    }

</style>